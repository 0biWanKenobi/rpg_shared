{
  "name": "rpg_shared",
  "version": "1.0.0",
  "description": "Shared lib for `rpg_master_plugin` and `rpg_player_plugin`",
  "license": "ISC",
  "author": "Obi Wan Kenobi",
  "type": "module",
  "exports": {
    "./settings/*": {
      "types": "./dist/settings/*.d.ts",
      "import": "./dist/settings/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./sync/*": {
      "types": "./dist/sync/*.d.ts",
      "import": "./dist/sync/*.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./styles.css": "./dist/rpg_shared.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:yalc": "cross-env PUSH_YALC_ON_WATCH=1 npm run dev",
    "build": "vite build",
    "yalc:publish": "run-os",
    "yalc:publish:win32": "npm run build && yalc publish --no-workspace-resolve",
    "yalc:publish:linux:darwin": "npm run build && ${YALC_BIN:-$HOME/.local/bin/yalc} publish --no-workspace-resolve",
    "yalc:push": "run-os",
    "yalc:push:win32": "npm run build && yalc push --no-workspace-resolve",
    "yalc:push:linux:darwin": "npm run build && ${YALC_BIN:-$HOME/.local/bin/yalc} push --no-workspace-resolve"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "obsidian": "^1.12.3",
    "run-script-os": "^1.1.6",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@preact/signals": "^2.8.2"
  }
}